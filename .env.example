# decoupled-wp-spark — environment
# Copy to .env for any non-DDEV environment. DDEV provides the DB_* vars
# automatically, so .env is optional for local DDEV development.

DB_NAME=db
DB_USER=db
DB_PASSWORD=db
DB_HOST=db

WP_HOME='https://decoupled-wp-spark.ddev.site'
WP_SITEURL="${WP_HOME}/wp"
WP_ENV=development
WP_DEBUG=true

# The decoupled Astro frontend (astro-spark). The WP admin's View /
# Preview buttons rewrite to this; public WP front-end hits redirect here.
SPARK_FRONTEND_URL=http://localhost:4321

# Where the Compliance Dashboard reads audit JSON from. Defaults to
# SPARK_FRONTEND_URL — set to the deployed demo URL in production.
SPARK_AUDIT_URL=http://localhost:4321

# Shared secret gating the Astro /api/preview endpoint. Must match the
# WORDPRESS_PREVIEW_SECRET in the frontend's .env.
WORDPRESS_PREVIEW_SECRET=spark_preview_dev_secret

# Token sent with on-save revalidation requests to the frontend.
SPARK_REVALIDATE_BYPASS_TOKEN=spark-revalidate-dev-token

# Secret for wp-graphql-jwt-authentication (headless preview login).
GRAPHQL_JWT_AUTH_SECRET_KEY=change-me-in-production
